# LOCAL PILOT: Auth0, QoreID Test NIN, and disabled Monnify preparation. No production mode.
NODE_ENV=development
TRUEID_PORT=4200
# JSON operational logs: debug, info, warn, error. Values and raw requests are omitted.
TRUEID_LOG_LEVEL=info
# Development database credentials only; never reuse in production.
DATABASE_URL=postgresql://trueid:trueid_local_test_only@127.0.0.1:55432/trueid
# Exact origins only. Empty means browser cross-origin access is denied.
TRUEID_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# No signing keys, provider secrets, or real identity numbers/documents belong here.
# Auth0 developer tenant only. Set all four outside source control to enable account access.
# Blank settings leave health available and protected routes closed.
TRUEID_AUTH0_TENANT_MODE=
TRUEID_AUTH0_ISSUER=
TRUEID_AUTH0_AUDIENCE=
TRUEID_AUTH0_MOBILE_CLIENT_ID=
# No client secret is needed by this resource server or the public native app.

# QoreID: set all four only in ignored .env or secret-manager injection.
# Default preserves QoreID. Selecting monnify returns verification_unavailable;
# it does not enable network calls or fall back to QoreID.
TRUEID_VERIFICATION_PROVIDER=qoreid
TRUEID_MONNIFY_MODE=disabled
# Do not configure Monnify credentials or URLs yet: nonempty settings are rejected.
# Use keys provisioned as Test in QoreID; Test and Live share the same API host.
# Both mode=sandbox and route=nin are required. Blank settings disable submissions.
TRUEID_QOREID_MODE=
TRUEID_QOREID_ROUTE=
TRUEID_QOREID_TEST_CLIENT_ID=
TRUEID_QOREID_TEST_CLIENT_SECRET=
# Optional integration test opt-in: TRUEID_RUN_QOREID_SANDBOX_TESTS=true

# Credentials: use only in a separate ignored .env.test with NODE_ENV=test.
# Blank settings disable issuance. Production/development signing is rejected.
TRUEID_CREDENTIAL_SIGNING_MODE=
TRUEID_TEST_SIGNING_KEY_ID=
