{
  "name": "@trueid/backend",
  "version": "0.1.0",
  "private": true,
  "description": "TrueID consent-first identity pilot backend — scoped partner consent",
  "packageManager": "npm@11.4.2",
  "engines": { "node": "^22.13.0 || >=24.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests --max-warnings 0",
    "test": "npm run build:test && node --test dist-test/tests/*.test.js",
    "test:postgres": "npm run build:test && node --test dist-test/tests/postgres.integration.js",
    "test:auth0": "npm run build:test && node --test dist-test/tests/auth0-sandbox.integration.js",
    "test:qoreid": "npm run build:test && node --env-file=.env --test dist-test/tests/qoreid-sandbox.integration.js",
    "build:test": "tsc -p tsconfig.test.json",
    "start": "node --env-file=.env dist/src/main.js",
    "start:runtime": "node dist/src/main.js",
    "db:migrate:runtime": "node dist/scripts/migrate.js",
    "smoke:runtime": "node dist/scripts/smoke-runtime.js",
    "dev": "npm run build && node --env-file=.env --watch dist/src/main.js",
    "db:migrate": "npm run build && node --env-file=.env dist/scripts/migrate.js",
    "keys:test": "npm run build && node --env-file=.env.test dist/scripts/generate-test-signing-key.js",
    "partners:register": "npm run build && node --env-file=.env dist/scripts/partner-client.js register",
    "partners:disable": "npm run build && node --env-file=.env dist/scripts/partner-client.js disable",
    "partners:rotate": "npm run build && node --env-file=.env dist/scripts/partner-client.js rotate",
    "partners:revoke-key": "npm run build && node --env-file=.env dist/scripts/partner-client.js revoke-key",
    "partners:keys": "npm run build && node --env-file=.env dist/scripts/partner-client.js keys",
    "start:test": "node --env-file=.env.test dist/src/main.js",
    "check": "npm test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "jose": "^6.2.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.0.0",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
